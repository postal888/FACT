FACTIVA_USER=
FACTIVA_PASS=

# Content focus for topic prioritization (comma-separated, free text).
# FOCUS_INTERESTS: what you want surfaced first (importance ranking follows this).
# FOCUS_BORING: themes to push down/skip (niche/local stories with no broad hook).
FOCUS_INTERESTS=технологии, бизнес, финансы, стартапы, ИИ, рынки, венчурные инвестиции, крупные сделки и M&A
FOCUS_BORING=локальная связь/инфраструктура в отдельных странах, узкие региональные/военные/гуманитарные сюжеты без бизнес-контекста, рутинные корпоративные пресс-релизы

# Ranking tuning (optional — defaults shown). Adjust without touching code.
# How much article importance vs. fit-to-your-interests weighs in the final rank.
FOCUS_WEIGHT_IMPORTANCE=0.5
FOCUS_WEIGHT_INTEREST=0.5
# Penalty subtracted from the rank when an item is flagged boring (higher = sinks harder).
FOCUS_BORING_PENALTY=3.0
# Drop boring items entirely when enough non-boring ones remain (true/false).
FOCUS_DROP_BORING=true

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Model tiers ---
# Quality model for writing/refining posts (the visible output).
MODEL_WRITE=claude-opus-4-5
# Cheap model for mechanical tasks: focus scoring, story dedup, topic
# clustering, translation, Twitter-fit compression. Sonnet keeps JSON reliable
# at a fraction of opus cost; use claude-haiku-* for maximum savings.
MODEL_UTIL=claude-sonnet-4-5

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
